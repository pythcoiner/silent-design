{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "kit/**",
              "preview/**",
              "ui_kits/silent/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans|Noto Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans, Noto Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='QRCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<QRCard> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stack'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Stack> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimitivesNamespace'] > JSXAttribute > JSXIdentifier[name!=/^(?:Button|Input|DateTimeInput|TextArea|Display|Field|FieldGroup|Checkbox|Toggle|Spinner|Card|Badge|SelectRow|Notice|ModalStatus|Legend|ComboBox|ValidationMark|BalanceHeader|Tab|key|ref|className|style|children)$/]",
        "message": "<PrimitivesNamespace> doesn't accept that prop. Declared props: Button, Input, DateTimeInput, TextArea, Display, Field, FieldGroup, Checkbox, Toggle, Spinner, Card, Badge, SelectRow, Notice, ModalStatus, Legend, ComboBox, ValidationMark, BalanceHeader, Tab."
      },
      {
        "selector": "JSXOpeningElement[name.name='VariantsNamespace'] > JSXAttribute > JSXIdentifier[name!=/^(?:Btn|Pill|key|ref|className|style|children)$/]",
        "message": "<VariantsNamespace> doesn't accept that prop. Declared props: Btn, Pill."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "QRCard": {
        "replaces": []
      },
      "Icon": {
